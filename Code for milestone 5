#include "xc.h"
#pragma config FNOSC = FRC //edit if it needs a different timer

//goals of design:  driving forward in a straight line, 
//making a roughly 90-degree turn, driving forward again, and making a roughly 180-degree turn, and driving forward again.
//use half steps

int main(void){
  _ANSA0 = 0; // Digital I/O congifuration (disabled analog)
  _TRISA0 = 0; // Clear Port A TRIS register
  _LATA0 = 0; // Clear Port A latch register
  _ANSB0 = 0; // Digital I/O congifuration (disabled analog)
  _TRISB0 = 0; // Clear Port B TRIS register
  _LATB0 = 0; // Clear Port B latch register
  OC1CON1 = 0; //clear output compare for cont. 1
  OC1CON2 = 0; //clear output compare for cont. 2
  OC3CON1 = 0; //clear output compare for cont. 1
  OC3CON2 = 0; //clear output compare for cont. 2
  TRISBbits.TRISB12  = 0; // set pin 15 to digital output for DIR pin on right side motor driver board (This sets direction of stepper)
  TRISBbits.TRISB2 = 0; // set pin 6 to digital output for DIR pin on left side of motor driver board (This sets direction of stepper)
  OC1CON1bits.OCTSEL = 0b111; // using oc onboard timer 
  OC1CON2bits.SYNCSEL = 0b11111; // something magical idk
  OC1CON2bits.OCTRIG = 0; // something magical idk 
  OC3CON1bits.OCTSEL = 0b111; // using oc onboard timer for other pwm signal 
  OC3CON2bits.SYNCSEL = 0b11111; // something magical idk 
  OC3CON2bits.OCTRIG = 0; // something magical idk 
  OC1RS = ; // set period for right motor
  OC1R = OC1RS * 2; // just use 50% duty cycle for simplicity
  OC1CON1bits.OCM = 0b110; // turns pwm on
  OC3RS = ; // set period for left motor
  OC3R = OC3RS * 2; // just use 50 % duty cycle for simplicity
  OC3CON1bits.OCM = 0b110; // turn on pwm
while (TMR1<max_timer_length){

//set each of these to specific timer values so we can get it to do what it needs to
//first one needs both motors to be moving
//second step needs one motor off, the other on for a certain number of time
//then both motors go forward
//then one motor off and other on for a long time
//repeat everything
LATBbits.LATB12 = 1; // set direction of motors (done outside if statement so they never change if want to just turn them on and off
LATBbits.LATB2 = 1; // set direction of motors 
 if (TMR1<2*3906//can change these values){
            //drive straight
            OC1R = OC1RS*.33;//duty cycle percents
            OC3R = OC3RS *.33;
        }
        if (TMR1>2*3906){
            //turn right 90 degrees, just needs to adjust the timer length
            // we could try and get fancy and flip OC1R is reverse by writing LATBbits.LATB12 = 0; to have it rotate in place
            OC1R = 0;
            OC3R = OC3RS *.33;
        }
        if (TMR1>5*3906){
            //drive straight again for an arbitrary amount of time
            
            OC1R = OC1RS*.33;
            OC3R = OC3RS *.33;
  
}
        if (TMR1>7*3906){
        //180 degree turn adjust timer length for correct rotation time or set up ISR with step counter if wanted 
        OC1R = OC1RS*0;
        OC3R = OC3RS*.33;
        }  

        if (TMR1 > 9*3906) {
        //final drive forward
        OC1R = OC1RS *.33;
        OC3R = OC3RS *.33;
        }
return 0;
}

